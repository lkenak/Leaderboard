# Clé Riot Games. Prendre une clé PERSONNELLE sur https://developer.riotgames.com
# (« Register Product » → Personal) : elle n'expire pas, contrairement à la clé
# de développement qui meurt toutes les 24 h.
#
# Ne jamais committer ce fichier rempli : `.env*` est ignoré par git, seul
# `.env.example` est suivi.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secret protégeant /api/refresh (le job de rafraîchissement). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
REFRESH_SECRET=

# Connexion Discord (Auth.js). Créer une application sur
# https://discord.com/developers/applications, y ajouter un redirect URI
#   http://localhost:3000/api/auth/callback/discord   (dev)
# Client ID et Client Secret viennent de l'onglet OAuth2 de l'application.
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Secret de signature des sessions Auth.js. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Obligatoire dès que le site tourne derrière un reverse proxy (Caddy, Nginx)
# qui n'est pas Vercel — sans ça, Auth.js refuse de faire confiance à l'en-tête
# Host transmis par le proxy.
AUTH_TRUST_HOST=true

# En développement local, inutile (localhost:3000 est détecté seul). En
# production derrière un reverse proxy, `trustHost` seul s'est révélé
# insuffisant (callback recalculé sur localhost malgré trustHost=true) :
# définir AUTH_URL=https://<domaine> dans /etc/leaderboard.env réel.
# AUTH_URL=

# Bot Discord. La MÊME application Discord que la connexion ci-dessus : le
# Client ID de l'onglet OAuth2 sert de DISCORD_APPLICATION_ID, et le token
# vient de l'onglet Bot. Inviter le bot avec les portées `bot` et
# `applications.commands`.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Serveur Discord de test. Quand elle est définie, `npm run bot:commands`
# publie les commandes sur ce seul serveur — visibles immédiatement, au lieu
# d'attendre la propagation d'une publication globale. À laisser vide en prod.
DISCORD_DEV_GUILD_ID=

# Deux adresses, volontairement distinctes : la première fabrique les liens
# cliquables des messages Discord, la seconde joint le serveur web sans
# repasser par le reverse proxy. AUTH_URL ne convient pour aucune des deux :
# c'est la variable d'Auth.js, elle sert aux URL de rappel OAuth.
LADDER_PUBLIC_URL=http://localhost:3000
LADDER_INTERNAL_URL=http://127.0.0.1:3000
