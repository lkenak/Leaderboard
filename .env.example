# Clé Riot Games. Prendre une clé PERSONNELLE sur https://developer.riotgames.com
# (« Register Product » → Personal) : elle n'expire pas, contrairement à la clé
# de développement qui meurt toutes les 24 h.
#
# Cette variable est FACULTATIVE : la clé peut aussi se coller depuis /admin,
# ce qui évite d'éditer ce fichier et de relancer le serveur chaque jour tant
# qu'on en est réduit à une clé de développement. Une clé saisie à l'écran
# prime sur celle-ci ; « Oublier cette clé » rend la main à cette variable.
# Pour un déploiement multi-instances (Vercel), c'est ici qu'il faut la mettre.
#
# Ne jamais committer ce fichier rempli : `.env*` est ignoré par git, seul
# `.env.example` est suivi.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secret protégeant /api/refresh (le job de rafraîchissement). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
REFRESH_SECRET=

# Optionnel : mot de passe de la page /admin. Vide = la page n'est accessible
# qu'en développement local.
ADMIN_PASSWORD=
