# /etc/caddy/Caddyfile
#
# Caddy obtient et renouvelle le certificat tout seul : rien à automatiser, rien
# à surveiller. Remplacer le domaine et recharger :
#
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

ladder.exemple.fr {
	encode zstd gzip

	# Les routes internes ne sont appelées que depuis 127.0.0.1, par le bot
	# Discord (rendu des cartes). Les exposer au monde n'a aucun usage, et un
	# 404 vaut mieux qu'un 401 : il ne confirme même pas leur existence. Le
	# secret Bearer côté route reste la seconde ligne de défense, pas la
	# première.
	@interne path /api/internal/*
	respond @interne 404

	reverse_proxy 127.0.0.1:3000

	# Next gère lui-même le cache de ses assets versionnés ; on ne fait que
	# transmettre. Un `header` trop zélé ici casserait la revalidation.
	log {
		output file /var/log/caddy/ladder.log
		format console
	}
}

