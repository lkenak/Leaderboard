# /etc/leaderboard.env  —  chmod 600, chown root:root
#
# systemd lit ce fichier sans passer par un shell : pas de guillemets autour
# des valeurs, pas de substitution, une paire clé=valeur par ligne.

# — Obligatoire —
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
REFRESH_SECRET=

# — Connexion Discord (Auth.js). Application à créer sur
#   https://discord.com/developers/applications, redirect URI :
#   https://<ton-domaine>/api/auth/callback/discord —
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_SECRET=
AUTH_TRUST_HOST=true
# AUTH_URL explicite : `trustHost` seul ne suffit pas toujours à faire
# détecter le bon domaine derrière Caddy (observé : callback recalculé sur
# localhost malgré trustHost=true). Remplacer par le domaine réel.
AUTH_URL=https://<ton-domaine>

# — Bot Discord. Même application Discord que la connexion du site : le Client
#   ID de l'onglet OAuth2 sert d'APPLICATION_ID, le token vient de l'onglet
#   Bot. Portées de l'invitation : bot + applications.commands. —
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Serveur d'itération : celui sur lequel `npm run bot:commands -- --serveur`
# publie, pour voir une nouvelle commande sans attendre la propagation globale
# (qui peut prendre une heure). Elle DÉSIGNE un serveur, elle ne choisit pas la
# portée — c'est le drapeau --serveur qui choisit. La laisser définie même en
# publication globale permet au script de vider le jeu de ce serveur, et donc
# d'éviter que chaque commande apparaisse en double.
# DISCORD_DEV_GUILD_ID=

# — Deux adresses, volontairement distinctes : l'une fabrique les liens
#   cliquables des messages Discord, l'autre joint le serveur web sans
#   repasser par Caddy, le DNS ni le certificat. AUTH_URL ne convient pour
#   aucune des deux : c'est la variable d'Auth.js, elle sert à calculer des
#   URL de rappel OAuth. —
LADDER_PUBLIC_URL=https://<ton-domaine>
LADDER_INTERNAL_URL=http://127.0.0.1:3000

# — L'historique de LP, hors du dossier de déploiement : c'est la seule donnée
#   que rien ne peut reconstruire, elle ne doit pas disparaître à la prochaine
#   mise à jour. —
LADDER_DATA_DIR=/var/lib/leaderboard

# — Sans ça, un VPS est en UTC et le site affiche deux heures de moins —
TZ=Europe/Paris

# — Réglages —
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
REFRESH_INTERVAL_MS=300000
# Cadence de la voie rapide, qui ne vise que les joueurs en session. La
# descendre sous l'intervalle réel entre deux parties n'apporte rien ; la
# monter au-dessus de ~2 min laisse repasser des parties non chiffrées.
SESSION_INTERVAL_MS=90000
SPLIT_NAME=Split 3 · 2026
# SPLIT_ENDS_AT=2026-11-11T20:00:00Z
