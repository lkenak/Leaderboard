# /etc/systemd/system/leaderboard-refresh.timer
#
# Facultatif. Le site déclenche déjà un relevé à la visite quand le dernier
# dépasse REFRESH_INTERVAL_MS ; ce minuteur ne sert qu'à relever même les jours
# où personne ne consulte le site.
#
#   sudo systemctl enable --now leaderboard-refresh.timer
#   systemctl list-timers leaderboard-refresh
#
[Unit]
Description=Relevé périodique du classement SoloQ

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
# Évite que le relevé tombe pile à la minute ronde, quand tout le monde
# interroge l'API Riot.
RandomizedDelaySec=45s
AccuracySec=30s

[Install]
WantedBy=timers.target
