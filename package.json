{
  "name": "leaderboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "champions:sync": "node --use-env-proxy scripts/sync-champions.mjs",
    "riot:check": "node --use-env-proxy --env-file-if-exists=.env.local scripts/riot-check.mjs",
    "migrate:legacy": "node --env-file-if-exists=.env.local scripts/migrate-store-to-sqlite.mjs",
    "serve": "./deploy/serve.sh",
    "bot": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs bot/index.ts",
    "bot:dev": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs watch bot/index.ts",
    "bot:commands": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs bot/register-commands.ts",
    "prebuild": "node scripts/check-card-tokens.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.25.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.20.0",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3"
  }
}
